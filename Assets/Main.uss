.ribbonBigButton {
    width: 64px;
    height: 64px;
    overflow: hidden;
    border-color: rgb(116, 116, 116);
    border-width: 1px;
    border-radius: 3px;
}

.ribbonSmallButton {
    overflow: hidden;
    border-color: rgb(116, 116, 116);
    border-width: 1px;
    border-radius: 3px;
    width: 75px;
    font-size: 12px;
    height: 25px;
}

.ribbonGroup {
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding-left: 2px;
    padding-right: 2px;
    border-left-color: rgba(0, 0, 0, 0.5);
    border-left-width: 1px;
}

.ribbonGroup > Label {
    color: rgb(223, 223, 223);
}

.ribbonGroupVE {
    flex-direction: row;
}

#InfiniteScrollbar #unity-tracker {
    opacity: 0;
    top: 7px;
    height: 16px;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

#InfiniteScrollbar:hover #unity-tracker {
    opacity: 1;
    transition-property: opacity;
    transition-duration: 500ms;
}

.unity-button:hover {
    background-color: rgb(231, 231, 231);
    transition-property: background-color;
    transition-duration: 300ms;
}

#InfiniteScrollbar #unity-dragger {
    height: 16px;
    top: 16px;
    width: 10%;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}
